{
  "name": "zerokey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZeroKey integrations take-home exercise",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --project unit --project api",
    "test:smoke": "npm run build && vitest run --project smoke",
    "test:watch": "vitest",
    "coverage": "vitest run --project unit --project api --coverage",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "npm run hooks:install",
    "check:fast": "npm run typecheck && npm run lint && npm run test",
    "check": "npm run check:fast && npm run coverage && npm run test:smoke && npm audit --audit-level=high"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
